  "cards": [
    { "dot": "cyan", "title": "Frontend architecture", "items": ["Next.js App Router route groups split website, auth, and admin surfaces.", "Website layout loads profile with getme and wraps pages in StoreProvider; admin layout composes Sidebar, Header, and Toaster.", "Axios uses NEXT_PUBLIC_API_BASE_URL, withCredentials, and a browser token interceptor."] },
    { "dot": "violet", "title": "API route map", "items": ["/api/category: list, detail, create, edit, status, delete.", "/api/room-type: list, detail, create, edit, status, delete.", "/api/product: list, detail, create, edit, status, flag, images.", "/api/user, /api/cart, /api/order, /api/contact are mounted in Backend/src/index.js; see the API routes focus for protected operations."] },
    { "dot": "emerald", "title": "Authentication flow", "items": ["Register/login controllers generate OTPs and persist expiry; sendOtpmail uses Brevo when configured, otherwise Gmail/Nodemailer.", "OTP verification signs a JWT and sets the token cookie.", "protect accepts the cookie first, then Authorization, verifies SECRET_KEY, loads the user, and authorized enforces admin/superAdmin roles."] },
    { "dot": "amber", "title": "Complete data flow", "items": ["Browser -> Next.js storefront or admin -> Axios -> Express route module -> controller -> Mongoose model -> MongoDB.", "Catalog image writes branch through multer-storage-cloudinary to Cloudinary.", "Checkout calls Razorpay order creation and signature verification, then persists payment IDs on Order.", "User-facing auth starts at register/login, branches to OTP email delivery, and returns through JWT cookie/Bearer authorization."] },
    { "dot": "rose", "title": "Evidence boundary", "items": ["Diagram facts are pinned to committed revision 59be8d0c505932fceb033734472c49b5acf306f6.", "The worktree has local edits in Backend/src/config/db.js and Backend/src/index.js; those edits are not used as committed evidence.", "Deployment hosting, runtime ports beyond the code default, and production database topology are not asserted beyond the inspected source."] }
